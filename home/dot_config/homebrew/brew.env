# Shared defaults for manual commands and chezmoi maintenance.
HOMEBREW_NO_ANALYTICS=1
HOMEBREW_BAT=1
HOMEBREW_NO_ENV_HINTS=1
HOMEBREW_AUTO_UPDATE_QUIET=1
HOMEBREW_DISPLAY_INSTALL_TIMES=1
# Install missing packages; use brew upgrade to update existing ones.
HOMEBREW_NO_INSTALL_UPGRADE=1
# Monthly maintenance runs cleanup explicitly after all upgrades.
HOMEBREW_NO_INSTALL_CLEANUP=1
# Keep recent downloads for reuse; monthly cleanup removes caches older than 60 days.
HOMEBREW_CLEANUP_MAX_AGE_DAYS=60
# Leave self-updating applications to their own updaters.
HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1
