#!/bin/zsh -eu

typeset -gr cargo_home="${CARGO_HOME:-$HOME/.cargo}"
typeset -gr cargo_bin_dir="$cargo_home/bin"
typeset -gr cargo_env_file="$cargo_home/env"
typeset -gr cargo_installed_file="$cargo_home/.crates.toml"

# Only tools whose Homebrew formula would pull in extra libraries, see docs/tools/rust.md
typeset -ga desired_rust_packages=(
    atuin
    bat
    eza
    git-delta
    ripgrep
)

# Extra `cargo install` arguments, per package
typeset -gA rust_package_args=(
    # Statically link OpenSSL (a no-op on macOS), Linux hosts often lack its headers (libssl-dev)
    atuin "--features vendored-tls"
)

# Uninstalled from ~/.cargo/bin if present (moved to the Brewfile, or no longer used)
typeset -ga obsolete_rust_packages=(
    cargo-binstall
    cargo-cache
    cargo-update
    dua-cli
    fd-find
    tokei
    tre-command
    uv
    xh
    zoxide
)

prepend_to_path() {
    local dir="$1"

    [[ -d "$dir" ]] || return 0

    case ":$PATH:" in
        *":$dir:"*) ;;
        *) export PATH="$dir:$PATH" ;;
    esac
}

ensure_cargo_path() {
    prepend_to_path "$cargo_bin_dir"

    if ! command -v cargo > /dev/null && [[ -f "$cargo_env_file" ]]; then
        source "$cargo_env_file"
        prepend_to_path "$cargo_bin_dir"
    fi
}

ensure_rustup() {
    if [[ ! -x "$cargo_bin_dir/rustup" ]]; then
        echo Installing rustup
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal
    fi

    ensure_cargo_path
    command -v cargo > /dev/null
    command -v rustup > /dev/null
}

cargo_installed_packages() {
    [[ -r "$cargo_installed_file" ]] || return 0
    cargo install --list | awk '/^[^ ]+ v[^ ]+:$/ { print $1 }'
}

cleanup_obsolete_rust_packages() {
    local -a installed_packages
    local pkg_name

    installed_packages=($(cargo_installed_packages))
    for pkg_name in "${obsolete_rust_packages[@]}"; do
        if (( ${installed_packages[(Ie)$pkg_name]} != 0 )); then
            cargo uninstall "$pkg_name"
        fi
    done

    # State left behind by cargo-binstall, no longer used
    rm -rf "$cargo_home/binstall" "$cargo_home/binstall.toml"
}

install_rust_package() {
    local pkg_name="$1"

    # --locked builds with the crate's published Cargo.lock; some (e.g. git-delta) pull yanked deps otherwise.
    # Already up-to-date packages are a no-op, so this doubles as the upgrade path.
    cargo install --locked ${=rust_package_args[$pkg_name]-} "$pkg_name" || print "WARN: skipped $pkg_name: install failed"
}

manage_rust_cli_tools() {
    local -a installed_packages
    local -a package_names
    local pkg_name
    local -i rustup_was_installed=0

    if [[ -x "$cargo_bin_dir/rustup" ]]; then
        rustup_was_installed=1
    fi

    ensure_rustup

    if (( rustup_was_installed )); then
        rustup self update
        rustup update
    fi

    cleanup_obsolete_rust_packages

    installed_packages=($(cargo_installed_packages))
    package_names=("${(@f)$(print -rl -- "${desired_rust_packages[@]}" "${installed_packages[@]}" | LC_ALL=C sort -u)}")
    for pkg_name in "${package_names[@]}"; do
        if (( rustup_was_installed || ${installed_packages[(Ie)$pkg_name]} == 0 )); then
            install_rust_package "$pkg_name"
        fi
    done
}

if (( $# != 0 )); then
    print -u2 "usage: $0"
    exit 1
fi

manage_rust_cli_tools
