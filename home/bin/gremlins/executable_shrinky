#!/usr/bin/env python3
"""
Standalone script used to render PS1 parts and shortened folder names for tmux window names and shell prompts.
Must work fast, with system python, std libs only
"""

from __future__ import annotations

import contextlib
import os
import socket
import sys
from pathlib import Path
from typing import NoReturn


class Logger:
    logger = None

    @classmethod
    def enable_logging(cls, log_location):
        import logging

        logging.basicConfig(
            filename=os.path.expanduser(log_location),
            datefmt="%m-%d %H:%M:%S",
            format="%(asctime)s [%(process)s] %(levelname)s %(message)s",
        )
        cls.logger = logging.getLogger(__name__)
        logging.root.setLevel(logging.DEBUG)
        cls.logger.setLevel(logging.DEBUG)

    @classmethod
    def debug(cls, message, *args):
        if cls.logger:
            cls.logger.debug(message, *args)

    @classmethod
    def fail(cls, msg, exit_code=1, exc_info=None) -> NoReturn:
        print(msg, file=sys.stderr)
        if cls.logger:
            cls.logger.error(msg, exc_info=exc_info)

        sys.exit(exit_code)


def run_program(*args: str) -> str:
    import subprocess

    Logger.debug("Running: %s", args)
    output = ""
    with contextlib.suppress(Exception):
        p = subprocess.run(args, capture_output=True, shell=False, text=True)  # noqa: S603
        output = p.stdout and p.stdout.strip()
        Logger.debug("  stdout: %s", output)

    return output


def get_path(path: str) -> Path:
    if path:
        if path.startswith('"') and path.endswith('"'):
            path = path.strip('"')

        path = os.path.expanduser(path)

    return Path(path or os.getcwd())


def get_py_venv_version(venv_path: Path) -> str:
    """Fast Python Version detection without subprocess calls, looking for lib/pythonM.m"""
    version = "?"
    for lib_path in (venv_path / "lib", venv_path / "lib64"):
        if lib_path.is_dir():
            for d in lib_path.iterdir():
                if d.name.startswith("python"):
                    version = d.name.replace("python", "")
                    break

    return version


def git_branch_name(folder: Path) -> str | None:
    git_folder = git_root(folder)
    head_file = git_folder and git_folder / "HEAD"
    if head_file and head_file.exists():
        try:
            content = head_file.read_text().strip()
            if content.startswith("ref: "):
                return content.rpartition("/")[2]  # "ref: refs/heads/<branch-name>"

            return content[:5]  # Detached HEAD (SHA)

        except OSError:
            return None


def git_root(folder: Path) -> Path | None:
    for parent in (folder, *folder.parents):
        folder = parent / ".git"
        if folder.is_dir():
            return folder


def scm_root(folder: Path) -> Path | None:
    folder = git_root(folder)
    if folder:
        return folder.parent


def capped_text(text: str, max_size: int) -> str:
    if max_size and text and len(text) > max_size:
        text = f"…{text[-max_size:]}"

    return text


class ColorBit:
    def __init__(self, name: str, open_marker: str, close_marker: str, wrapper_fmt=""):
        self.name = name
        self.open_marker = open_marker
        self.close_marker = close_marker
        self.wrapper_fmt = wrapper_fmt

    def wrapped(self, marker: str) -> str:
        if self.wrapper_fmt:
            marker = self.wrapper_fmt % marker

        return marker

    def __call__(self, text: str) -> str:
        open_marker = self.wrapped(self.open_marker)
        close_marker = self.wrapped(self.close_marker)
        return f"{open_marker}{text}{close_marker}"


def is_bounds(value) -> bool:
    """Is `value` a pair of numbers (as used by `ColorSet.graded()`)?"""
    return isinstance(value, tuple) and len(value) == 2 and all(isinstance(x, (int, float)) for x in value)


class ColorSet:
    available = ("bold", "dim", "blue", "green", "yellow", "red", "cyan")  # magenta
    __ttyc: ColorSet | None = None

    def __init__(self, name, bits):
        self.name = name
        self.bits: dict[str, ColorBit] = bits
        self.bold = self.bits["bold"]
        self.dim = self.bits["dim"]
        self.blue = self.bits["blue"]
        self.green = self.bits["green"]
        self.yellow = self.bits["yellow"]
        self.red = self.bits["red"]
        self.cyan = self.bits["cyan"]

    def graded(self, value: float | None, bounds: tuple[float, float]) -> ColorBit:
        """
        Color for `value` on a green/yellow/red scale, `bounds` being `(green_until, red_from)`: yellow in between
        (inclusive), green or red outside. The order tells the direction: `(150, 300)` means big is bad, `(50, 20)` means
        big is good (with equal bounds, big is bad). Dim when there's no value.
        """
        if value is None:
            return self.dim

        low, high = sorted(bounds)
        if low <= value <= high:
            return self.yellow

        big_is_good = bounds[0] > bounds[1]
        is_good = (value > high) == big_is_good
        return self.green if is_good else self.red

    def composed(self, style, value: float | None = None):
        """
        Function coloring a text as per `style`, which can be:
        - None: text is returned as-is
        - a color name ("dim"), or a `ColorBit` (self.dim)
        - bounds to grade `value` with, see `graded()`: (10, 20)
        - a tuple combining the above: ("dim", (10, 20))
        """
        parts = style if isinstance(style, tuple) and not is_bounds(style) else (style,)
        bits = []
        for part in parts:
            if isinstance(part, str):
                if part not in self.bits:
                    raise ValueError(f"Unknown color '{part}', available: {', '.join(self.available)}")

                part = self.bits[part]

            elif is_bounds(part):
                part = self.graded(value, part)

            if part:
                bits.append(part)

        def colored(text: str) -> str:
            for bit in bits:
                text = bit(text)

            return text

        return colored

    @classmethod
    def ttyc(cls) -> ColorSet:
        if cls.__ttyc is None:
            cls.__ttyc = cls.tty_color_set()

        assert cls.__ttyc
        return cls.__ttyc

    @classmethod
    def tty_color_set(cls, name="tty-colors", wrapper_fmt="") -> ColorSet:
        codes = {"bold": 1, "dim": 2, "blue": 34, "green": 32, "yellow": 33, "red": 31, "cyan": 36}
        code_format = "\x1b[%sm"
        bits = {}
        for color_name in cls.available:
            code = codes[color_name]
            clear = code_format % (39 if code > 9 else 22)
            bits[color_name] = ColorBit(color_name, code_format % code, clear, wrapper_fmt=wrapper_fmt)

        return cls(name, bits)

    @classmethod
    def color_set_by_name(cls, color_set_name: str | None):
        if color_set_name == "zsh":
            codes = {"bold": ("%B", "%b"), "dim": ("%{\x1b[2m%}", "%{\x1b[22m%}")}
            bits = {k: ColorBit(k, *codes.get(k, ("%%F{%s}" % k, "%f"))) for k in cls.available}
            return cls("zsh-ps1", bits)

        if color_set_name == "bash":
            return cls.tty_color_set(name="bash-ps1", wrapper_fmt="\\[%s\\]")

        if color_set_name == "tty":
            return cls.ttyc()

        if not color_set_name or color_set_name == "plain":
            return cls("plain", {k: ColorBit(k, "", "") for k in cls.available})

        Logger.fail(f"No color set for '{color_set_name}'")


def shortened_path(prefix: str, parts, pivot=4, max_parts=9):
    yield prefix
    if len(parts) > max_parts:
        yield "…"
        parts = parts[-max_parts:]

    pivot = len(parts) - pivot
    for i, part in enumerate(parts):
        if i < pivot:
            yield part[0] if part[0] not in (".", "_") else part[0:2]

        else:
            yield part


def folder_parts(folder: Path) -> tuple[str, tuple[str]]:
    try:
        return "~", folder.relative_to(get_path("~")).parts

    except ValueError:
        return "", folder.parts[1:]


class CommandRenderer:
    flags: dict[str, str]


class PathCleaner(CommandRenderer):
    flags = {"p": "path"}
    path = ""

    def cmd_clean_path(self):
        """Remove duplicates in PATH (but keep order)"""
        path = self.path or os.environ.get("PATH") or ""
        seen = set()
        for folder in path.split(os.pathsep):
            folder = get_path(folder)
            if folder not in seen and folder.is_dir():
                yield str(folder)

            seen.add(folder)


class Ps1Renderer(CommandRenderer):
    # example: ps1 -czsh -p.. -ozsimic,zoran -ufoo
    flags = {"c": "color", "o": "owner", "p": "pwd", "u": "user", "v": "venv", "x": "exit_code"}

    color = ""
    exit_code = "0"
    owner = ""
    pwd = ""
    user = ""
    venv = ""

    def cmd_ps1(self):
        """
        PS1 minimalistic prompt
        """
        colors = ColorSet.color_set_by_name(self.color)
        if self.user == "root":
            yield "❕ "

        elif os.environ.get("CODER"):
            yield colors.cyan("  ")  #   

        elif os.environ.get("SSH_TTY"):
            yield colors.cyan(" ")  # 📡   󰑔  󰢹
            hostname = socket.gethostname().partition(".")[0]
            yield f"{colors.dim(hostname)} "

        elif os.environ.get("container"):
            yield "🐳 "

        if self.venv:
            venv = get_path(self.venv)
            activate = venv / "bin/activate"
            py_version = get_py_venv_version(venv)
            venv_name = None
            if activate.exists():
                import re

                regex = re.compile(r'''^\s*VIRTUAL_ENV_PROMPT="([^"]+)"''')
                for line in activate.read_text().splitlines():
                    m = regex.match(line)
                    if m:
                        venv_name = m.group(1)
                        break

            if not venv_name:
                if venv.name.startswith(".venv") or venv.name.startswith("venv"):
                    venv = venv.parent

                venv_name = venv.name

            venv_name = capped_text(venv_name, 24)
            py_version = capped_text(py_version, 5)
            yield f"({colors.cyan(venv_name)} {colors.blue(py_version)}) "

        if self.owner and self.user != "root":
            owners = self.owner.split(",")
            if self.user not in owners:
                yield f"{colors.blue(self.user)}@"

        if self.pwd:
            folder = get_path(self.pwd)
            prefix, parts = folder_parts(folder)
            short = "/".join(shortened_path(prefix, parts))
            dirname, _, basename = short.rpartition("/")
            if dirname:
                dirname += "/"

            yield colors.yellow(f"{colors.dim(dirname)}{basename} ")

        if self.exit_code:
            color = colors.green if self.exit_code == "0" else colors.red
            char = color("#" if self.user == "root" else "$")
            yield f"{char} "


class TmuxBranchSpec:
    def __init__(self, icon: str, color: str):
        self.icon = icon
        self.color = color


class TmuxBranchSpecs:
    def __init__(self):
        # Other icons: 🔀🧐🚨🚧📌🔧📄💡🍻️💫🩹🎨
        self.default = TmuxBranchSpec("🔧", "magenta")
        self.by_branch = {}
        self.add_branch_spec("✨", "cyan", "main")
        self.add_branch_spec("🏷", "cyan", "master")
        self.add_branch_spec("🚨", "purple", "publish")
        self.add_branch_spec("🚨", "purple", "release")

    def add_branch_spec(self, icon: str, color: str, branch: str):
        spec = TmuxBranchSpec(icon, color)
        self.by_branch[branch] = spec

    def get_spec(self, branch) -> TmuxBranchSpec:
        return self.by_branch.get(branch, self.default)


def rendered_uptime(stdout, colored=True) -> str:
    i = stdout.index("up")
    stdout = stdout[i + 2 :].strip()
    up = list(uptime_bits(stdout))
    up = " ".join(up[:2]) or "-uptime?-"
    if colored:
        up = tmux_colored(up, "default,dim", 10)
        up = f"{up}🔌"  # 🕤⏳🪫🔋🔌

    return up


def tmux_colored(text: str, fg: str, max_size: int) -> str:
    text = capped_text(text, max_size)
    if fg:
        text = f"#[fg={fg}]{text}#[default]"

    return text


def uptime_bits(text: str):
    for bit in text.split(","):
        bit = bit.strip()
        if bit:
            if "user" in bit or "session" in bit or "load" in bit:
                return

            if ":" in bit:
                h, _, m = bit.partition(":")
                yield f"{int(h)}h"
                yield f"{int(m)}m"
                continue

            n, _, unit = bit.partition(" ")
            if n and unit:
                yield f"{int(n)}{unit[0]}"


class TmuxRenderer(CommandRenderer):
    path = ""
    flags = {"p": "path"}

    @staticmethod
    def rendered_branch(folder: Path) -> str | None:
        branch_name = git_branch_name(folder)
        if branch_name:
            specs = TmuxBranchSpecs()
            spec = specs.get_spec(branch_name)
            if spec:
                return f"{tmux_colored(branch_name, spec.color, 24)}{spec.icon}"

    def cmd_tmux_status(self):
        """
        Status for tmux status-right part

        Example:
          set -g status-right '#(/usr/bin/python3 shrinky tmux_status -p"#{pane_current_path}")'
        """
        folder = get_path(self.path)
        if folder:
            yield self.rendered_branch(folder)

        uptime = run_program("uptime")
        if "up" in uptime:
            yield rendered_uptime(uptime)

    def cmd_tmux_short(self):
        """
        Short name to show for a given tmux window

        Example:
          setw -g automatic-rename-format '#(/usr/bin/python3 shrinky tmux_short -b📌yellow+✨blue,master,main -p"#{pane_current_path}")'
        """
        folder = get_path(self.path)
        if folder == get_path("~"):
            yield "~"
            return

        root = scm_root(folder)
        folder = folder.name if not root or folder == root else f"{root.name}/{folder.relative_to(root).name}"
        yield capped_text(folder, max_size=20)


def rendered_dollar_amount(usd: float | None, pivot=20) -> str:
    """Show dollar amount, don't bother showing cents for amounts bigger than `pivot`"""
    return "-" if not usd else f"${usd:.2f}" if usd < pivot else f"${usd:.0f}"


def rendered_duration(ms: float | None) -> str:
    if ms is None:
        return "-"

    hours, minutes = divmod(round(ms / 60000), 60)
    return f"{hours}h{minutes:02}m" if hours else f"{minutes}m"


def rendered_tokens(tokens: int | None) -> str:
    if tokens is None:
        return "-"

    if tokens < 1000:
        return str(tokens)

    return f"{round(tokens / 1000)}k" if tokens < 999_500 else f"{tokens / 1_000_000:.1f}M"


class ClaudeRenderer(CommandRenderer):
    flags = {"c": "color", "i": "input"}
    color = "tty"
    input = ""

    colors: ColorSet

    def rendered_percentage(self, label: str, value: float | None, color=None) -> str:
        """
        Dim `label`, followed by `value` as a percentage, colored as per `color` (see `ColorSet.composed()`).
        A label in parentheses wraps the whole: "(cache hit)" renders as "(cache hit 96%)".
        """
        text = self.colors.composed(color, value)("-" if value is None else f"{round(value)}%")

        if label.startswith("("):
            return f"{self.colors.dim(label[:-1])} {text}{self.colors.dim(')')}"

        return f"{self.colors.dim(label)} {text}"

    def rendered_model(self, data: dict):
        model = data.get("model") or {}
        effort = data.get("effort") or {}
        model = self.colors.green(model.get("display_name") or model.get("id") or "?")
        if (data.get("thinking") or {}).get("enabled") is False:
            model = f"🫥 {model}"  # Thinking is always on with recent models, flag it when it's off

        if data.get("fast_mode"):
            model = f"{model} ⚡"

        effort = effort.get("level")
        if effort:
            effort = f"({effort})"
            effort = self.colors.cyan(effort)
            model = f"{model} {effort}"

        yield model

    def rendered_context(self, data: dict):
        context_window = data.get("context_window") or {}
        prompt_cache = data.get("prompt_cache") or {}
        tokens = context_window.get("total_input_tokens")
        # Context size (in tokens), nudge towards starting a new session (answers get less focused, every turn re-reads whole context)
        text = self.colors.composed((140_000, 200_000), tokens)(rendered_tokens(tokens))

        # Flag a cold prompt cache (next message re-sends the whole context) on a big enough context
        if tokens is not None and prompt_cache.get("warm") is False and tokens >= 40_000:
            text = f"🧊 {text}"

        hit_ratio = prompt_cache.get("hit_ratio")
        if hit_ratio is not None:  # Temporary, to see how it evolves
            # Prompt cache hit percentage: green above 90%, red below 80%
            text += f" {self.rendered_percentage('(cache hit)', hit_ratio * 100, color=('dim', (90, 80)))}"

        yield f"{self.colors.dim('ctx')} {text}"

    def rendered_limit(self, name: str, limit: dict, reset_format: str) -> str:
        used = limit.get("used_percentage")
        # Percentage of usage limit left: green above 50%, red below 15%
        text = self.rendered_percentage(name, None if used is None else 100 - used, (50, 15))
        resets_at = limit.get("resets_at")
        if resets_at:
            from datetime import datetime

            text += self.colors.dim(f" ↻{datetime.fromtimestamp(resets_at).strftime(reset_format)}")

        return text

    def rendered_limits(self, limits: dict):
        five_hour = self.rendered_limit("5h", limits.get("five_hour") or {}, "%H:%M")
        seven_day = self.rendered_limit("7d", limits.get("seven_day") or {}, "%a %H:%M")
        yield f"{self.colors.dim('left')} {five_hour}  {seven_day}"

    def rendered_cost(self, cost: dict):
        if cost:
            usd = cost.get("total_cost_usd") or None
            ms = cost.get("total_duration_ms")
            hours = None if ms is None else ms / 3_600_000

            # Session cost (API-equivalent, in $): green below $5, red above $20
            yield f"{self.colors.dim('cost:')} {self.colors.composed(('dim', (5, 20)), usd)(rendered_dollar_amount(usd))}"

            # Session duration (wall clock, in hours): green below 2h, red above 8h
            yield self.colors.composed(("dim", (2, 8)), hours)(rendered_duration(ms))

    def cmd_claude_statusline(self):
        """
        Claude Code status line: thinking off, model (effort), context size (cold cache), 5h/7d usage limits left with their reset times,
        session cost and duration

        Reads Claude Code's session JSON from stdin, or from file given via -i
        Example (~/.claude/settings.json):
          "statusLine": {"type": "command", "command": "/usr/bin/python3 ~/bin/gremlins/shrinky claude_statusline"}
        """
        import json

        with open(self.input or sys.stdin.fileno()) as fh:
            data = json.load(fh)

        self.colors = ColorSet.color_set_by_name(self.color)
        yield from self.rendered_model(data)
        yield from self.rendered_context(data)
        yield from self.rendered_limits(data.get("rate_limits") or {})
        yield from self.rendered_cost(data.get("cost") or {})


class CommandDef:
    def __init__(self, base_cls: type[CommandRenderer], name: str, delimiter: str):
        self.name = name
        self.base_cls = base_cls
        self.delimiter = delimiter

    def __repr__(self):
        return self.name

    def get_func(self, instance=None):
        func = getattr(instance or self.base_cls, f"cmd_{self.name}")
        return func

    def get_doc(self):
        func = self.get_func()
        doc = func.__doc__ or "?"
        return doc

    def summary(self) -> str:
        return self.get_doc().strip().splitlines()[0]

    def run_with_args(self, args):
        instance = self.base_cls()
        for arg in args:
            if not arg or len(arg) <= 1 or not arg.startswith("-"):
                Logger.fail(f"Unrecognized argument '{arg}'")

            key = arg[1]
            value = arg[2:]
            flag = self.base_cls.flags.get(key)
            if not flag:
                Logger.fail(f"Unknown flag '{key}'")

            setattr(instance, flag, value)

        func = self.get_func(instance=instance)
        bits = list(func())
        response = self.delimiter.join(x for x in bits if x)
        Logger.debug("%s %s -> %s", self, args, response)
        print(response)

    def show_help(self):
        from textwrap import dedent

        doc = self.get_doc()
        doc = dedent(doc).strip()
        print(f"{doc}\n", file=sys.stderr)
        sys.exit(0)


class CommandParser:
    def __init__(self):
        self.available_commands: dict[str, CommandDef] = {}

    def add_command(self, cmd: type[CommandRenderer], delimiter=""):
        for k in dir(cmd):
            if k.startswith("cmd_"):
                name = k[4:]
                cmd_def = CommandDef(cmd, name, delimiter)
                self.available_commands[name] = cmd_def

    def get_command(self, name: str) -> CommandDef:
        cmd = self.available_commands.get(name)
        if cmd is None:
            Logger.fail(f"Unknown command '{name}'")

        return cmd

    def show_help(self, msg=None, exit_code=0):
        if msg:
            print(msg, file=sys.stderr)

        print("Usage: COMMAND [ARGS]...", file=sys.stderr)
        print(__doc__, file=sys.stderr)
        print("\nCommands:", file=sys.stderr)
        for name, cmd in sorted(self.available_commands.items()):
            bold_name = ColorSet.ttyc().bold(f"{name:<18}")
            print(f"  {bold_name}{cmd.summary()}", file=sys.stderr)

        if exit_code is not None:
            sys.exit(exit_code)

    def run_args(self, args: list[str]):
        if not args:
            self.show_help("No command provided", exit_code=1)

        cmd = args[0]
        args = args[1:]
        if cmd == "--help":
            self.show_help()

        log_location = os.getenv("SHRINKY_LOG")
        if log_location:
            Logger.enable_logging(log_location)

        cmd = self.get_command(cmd)
        if "--help" in args:
            cmd.show_help()

        try:
            cmd.run_with_args(args)

        except Exception as e:  # pragma: no cover
            Logger.fail(f"'{cmd.name}()' crashed: {e}", exc_info=e)


def main(args=None):
    parser = CommandParser()
    parser.add_command(ClaudeRenderer, delimiter="  ")
    parser.add_command(PathCleaner, delimiter=os.pathsep)
    parser.add_command(Ps1Renderer)
    parser.add_command(TmuxRenderer, delimiter="┆")
    parser.run_args(args or sys.argv[1:])


if __name__ == "__main__":
    main()
